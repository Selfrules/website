# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# See SETUP_TOKENS.md for detailed instructions on obtaining tokens

# ==============================================================================
# APPLICATION
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ==============================================================================
# FIREBASE (Database, Authentication, Storage) - REQUIRED
# ==============================================================================
# Get from: Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"

# Firebase Admin SDK (for server-side operations) - PRODUCTION METHOD
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Extract values from the downloaded JSON file:
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ALTERNATIVE: Local Development (NOT for production)
# Place firebase-admin-key.json in root directory (already in .gitignore)
# Only used if environment variables above are not set

# ==============================================================================
# AUTHENTICATION (NextAuth.js) - REQUIRED
# ==============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HERE
NEXTAUTH_URL=http://localhost:3000

# Admin credentials
ADMIN_EMAIL=mattia@selfrules.org
# Default password: 'admin123' (CHANGE IN PRODUCTION!)
ADMIN_PASSWORD_HASH=$2a$12$JvWRVN79guQ8lFFfUhNQFeJ7pdLQJ.gYahsq0aKGONYpCqz42FKXq

# ==============================================================================
# ANTHROPIC CLAUDE API (Chatbot) - REQUIRED
# ==============================================================================
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.7

# ==============================================================================
# GOOGLE CALENDAR API (Booking System) - REQUIRED
# ==============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_ID=mattia@selfrules.org
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# Get refresh token: See SETUP_TOKENS.md section 4
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN_HERE

# ==============================================================================
# SPOTIFY API (Now Playing Widget)
# ==============================================================================
# Register at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Get refresh token: See SETUP_TOKENS.md section 3
SPOTIFY_REFRESH_TOKEN=YOUR_SPOTIFY_REFRESH_TOKEN_HERE
NEXT_PUBLIC_SPOTIFY_ENABLED=true

# ==============================================================================
# RATE LIMITING (Upstash Redis) - REQUIRED FOR PRODUCTION
# ==============================================================================
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN_HERE

# Rate limiting configuration (requests per time window)
RATE_LIMIT_CHAT=10:1m           # 10 requests per minute for chat
RATE_LIMIT_ANALYTICS=100:1m     # 100 requests per minute for analytics
RATE_LIMIT_CALENDAR=3:1m        # 3 requests per minute for booking
RATE_LIMIT_API_DEFAULT=50:1m    # 50 requests per minute for other APIs

# ==============================================================================
# ANALYTICS (Umami Cloud)
# ==============================================================================
# Get from: https://cloud.umami.is/ after creating a website
# Website ID (required)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=fbcdf857-0a39-4929-9d50-06422f9e3983
# Host URL (optional, defaults to cloud.umami.is)
NEXT_PUBLIC_UMAMI_HOST_URL=https://cloud.umami.is
# Enable/disable Umami tracking (optional, defaults to enabled in production)
NEXT_PUBLIC_UMAMI_ENABLED=true

# ==============================================================================
# OPTIONAL SERVICES
# ==============================================================================
# Analytics retention (days)
ANALYTICS_RETENTION_DAYS=90

# Email notifications (SendGrid or Resend)
EMAIL_API_KEY=YOUR_EMAIL_API_KEY_HERE
EMAIL_FROM=notifications@selfrules.org

# Error monitoring (Sentry)
SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
FEATURE_AI_CHATBOT=false          # Enable when chatbot is implemented
FEATURE_CALENDAR_BOOKING=false    # Enable when calendar is implemented
FEATURE_SPOTIFY_WIDGET=false      # Enable when Spotify is configured
FEATURE_ANALYTICS=true            # Already implemented
RATE_LIMIT_ENABLED=false          # Enable when Upstash is configured
LOG_LEVEL=debug                   # Use 'info' in production

# ==============================================================================
# SECURITY KEYS (Auto-generated for development)
# ==============================================================================
SESSION_SECRET=auto-generated-on-first-run
ENCRYPTION_KEY=auto-generated-on-first-run
JWT_SECRET=auto-generated-on-first-run

# Legacy Redis URL (if using local Redis instead of Upstash)
REDIS_URL="redis://localhost:6379"
