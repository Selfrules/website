// Prisma schema for Mattia Portfolio Backend
// Database: PostgreSQL (production-ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for authentication and preferences
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  preferences String?  // JSON string: Store user preferences like theme, language, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  chatConversations ChatConversation[]
  calendarBookings  CalendarBooking[]
  analyticsEvents   AnalyticsEvent[]
  
  @@index([email])
  @@map("users")
}

// Blog post model with markdown content
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   // Full markdown content
  excerpt     String?  // Short summary
  category    String   // Design, Dev, Product, Personal, AMA
  locale      String   @default("en") // Language: 'en' or 'it'
  coverImage  String?  // URL to cover image
  readingTime Int?     // Estimated reading time in minutes
  published   Boolean  @default(false)
  publishedAt DateTime?
  metadata    String?  // JSON string: SEO metadata, tags, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([published, publishedAt])
  @@map("blog_posts")
}

// Chat conversation with AI chatbot
model ChatConversation {
  id         String   @id @default(cuid())
  userId     String?  // Optional for anonymous users
  sessionId  String   // Browser session identifier
  messages   String   // JSON string: Array of {role, content, timestamp}
  category   String?  // lead, networking, curious (auto-categorized)
  sentiment  String?  // positive, neutral, negative
  metadata   String?  // JSON string: Additional context like referrer, device, etc.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([sessionId])
  @@index([category])
  @@index([createdAt])
  @@map("chat_conversations")
}

// Calendar booking for consultation calls
model CalendarBooking {
  id          String   @id @default(cuid())
  userId      String?  // Optional user reference
  name        String
  email       String
  phone       String?
  dateTime    DateTime // Scheduled date and time
  duration    Int      @default(60) // Duration in minutes
  status      String   @default("pending") // pending, confirmed, cancelled, completed
  type        String   // consultation, brainstorming, mentorship
  notes       String?  // User notes/context
  adminNotes  String?  // Admin-only notes
  googleEventId String? // Google Calendar event ID
  reminderSent Boolean  @default(false)
  metadata    String?  // JSON string: Additional context
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([dateTime])
  @@index([status])
  @@index([email])
  @@map("calendar_bookings")
}

// Analytics event tracking
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?  // Optional user reference
  sessionId  String   // Browser session identifier
  eventType  String   // page_view, button_click, form_submit, etc.
  eventName  String   // Descriptive name like "hero_cta_clicked"
  page       String?  // Page where event occurred
  metadata   String?  // JSON string: Event-specific data (coordinates, duration, etc.)
  userAgent  String?
  ipAddress  String?
  referrer   String?
  timestamp  DateTime @default(now())
  
  // Relations
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([sessionId])
  @@index([eventType])
  @@index([eventName])
  @@index([timestamp])
  @@map("analytics_events")
}

// Newsletter subscriptions
model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  status      String   @default("active") // active, unsubscribed
  source      String?  // Where they subscribed from
  preferences String?  // JSON string: Email preferences
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@index([email])
  @@index([status])
  @@map("newsletter_subscriptions")
}

// Anonymous questions for "Ask Me Anything"
model Question {
  id          String   @id @default(cuid())
  name        String?  // Optional name (can be anonymous)
  email       String?  // Optional email for notification
  question    String   // The actual question
  category    String?  // Auto-categorized: Design, Dev, Product, Career, etc.
  status      String   @default("pending") // pending, answered, archived
  answeredAt  DateTime?
  blogPostId  String?  // Link to blog post if answered publicly
  sessionId   String?  // Browser session for analytics
  metadata    String?  // JSON string: Additional context
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([category])
  @@map("questions")
}

// Certifications and credentials
model Certification {
  id              String   @id @default(cuid())
  title           String   // e.g., "Certified Scrum Product Owner"
  issuer          String   // e.g., "Scrum Alliance"
  issueDate       DateTime
  expiryDate      DateTime?
  credentialId    String?  // Verification ID
  credentialUrl   String?  // Verification link
  description     String?  // Description or achievements
  skills          String?  // JSON string: Array of related skills
  logo            String?  // URL to issuer logo
  displayOrder    Int      @default(0) // Order to display on site
  visible         Boolean  @default(true)
  blockchain      String?  // Blockchain verification data
  metadata        String?  // JSON string: Additional data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([displayOrder])
  @@index([visible])
  @@index([issueDate])
  @@map("certifications")
}

// Testimonials and recommendations
model Testimonial {
  id              String   @id @default(cuid())
  name            String   // Person's name
  role            String   // e.g., "CEO at Company"
  company         String?
  avatar          String?  // URL to avatar image
  content         String   // Testimonial text
  rating          Int?     // Optional 1-5 rating
  relationship    String?  // e.g., "worked together", "client", "mentor"
  projectContext  String?  // What project/context this relates to
  verified        Boolean  @default(false) // Verification status
  linkedinUrl     String?  // LinkedIn profile for verification
  displayOrder    Int      @default(0)
  visible         Boolean  @default(true)
  featured        Boolean  @default(false) // Show on homepage
  locale          String   @default("en") // Language: 'en' or 'it'
  givenAt         DateTime? // When the testimonial was given
  metadata        String?  // JSON string: Additional data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([displayOrder])
  @@index([visible])
  @@index([featured])
  @@index([verified])
  @@map("testimonials")
}
